{
  "name": "openclaw-compact-handoff",
  "version": "0.1.0",
  "description": "OpenClaw hook pack that preserves session handoffs before compaction.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "files": [
    "hooks/compact-handoff",
    "scripts/test_compact_handoff_hook.mjs",
    "scripts/test_compact_handoff_resilience.mjs",
    "scripts/test_compact_handoff_p1c.mjs",
    "scripts/test_session_authority.mjs",
    "scripts/post_run_check.mjs",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [],
    "hooks": [
      "hooks/compact-handoff"
    ]
  },
  "scripts": {
    "test": "npm run test:core && npm run test:resilience && npm run test:p1c",
    "test:core": "node scripts/test_compact_handoff_hook.mjs",
    "test:resilience": "node scripts/test_compact_handoff_resilience.mjs",
    "test:p1c": "node scripts/test_compact_handoff_p1c.mjs",
    "postrun:check": "node scripts/post_run_check.mjs"
  },
  "keywords": [
    "openclaw",
    "hook",
    "compaction",
    "handoff",
    "memory"
  ]
}
